{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multibodysystemsdynamics.com/schemas/mbsd.spatial.constrained-result-v2.schema.json",
  "title": "MBSD Constrained Spatial Dynamic Result v2",
  "type": "object",
  "required": ["schema", "schema_version", "mbsd_version", "status", "solver_kind", "model_id", "excitation_id", "simulation_id", "identity_scope", "units", "conventions", "capabilities", "solver_status", "provenance", "diagnostics", "time", "constraint_layout", "multipliers", "constraint_jacobian", "position_residuals", "velocity_residuals", "acceleration_residuals", "interaction_force_world", "bodies"],
  "properties": {
    "schema": {"const": "mbsd.spatial.constrained_rigid_body_dynamic_result"},
    "schema_version": {"const": 2},
    "status": {"const": "experimental"},
    "solver_kind": {"const": "constrained_spatial_rigid_body_dynamics"},
    "model_id": {"type": "string", "minLength": 1},
    "excitation_id": {"type": "string", "minLength": 1},
    "simulation_id": {"type": "string", "minLength": 1},
    "identity_scope": {"type": "object"},
    "units": {"type": "object"},
    "conventions": {"type": "object"},
    "capabilities": {"type": "object"},
    "solver_status": {"type": "object"},
    "provenance": {"type": "object"},
    "diagnostics": {"type": "object"},
    "time": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "constraint_layout": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "multipliers": {"type": "array"},
    "constraint_jacobian": {"type": "array"},
    "position_residuals": {"type": "array"},
    "velocity_residuals": {"type": "array"},
    "acceleration_residuals": {"type": "array"},
    "interaction_force_world": {"type": "array"},
    "bodies": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
