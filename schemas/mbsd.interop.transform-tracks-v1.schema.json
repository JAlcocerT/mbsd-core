{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multibodysystemsdynamics.com/schemas/mbsd.interop.transform-tracks-v1.schema.json",
  "title": "MBSD Transform Tracks v1",
  "type": "object",
  "required": ["schema", "schema_version", "artifact_id", "source", "target", "capabilities", "tracks"],
  "properties": {
    "schema": {"const": "mbsd.interop.transform_tracks"},
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["schema", "schema_version", "solver_kind"]},
    "target": {
      "type": "object",
      "required": ["engine", "coordinate_handedness", "axis_matrix_source_to_target", "length_unit", "length_scale_from_m", "time_unit", "quaternion_order", "rotation"],
      "properties": {
        "coordinate_handedness": {"const": "right_handed"},
        "axis_matrix_source_to_target": {"$ref": "#/$defs/matrix3"},
        "length_scale_from_m": {"type": "number", "exclusiveMinimum": 0},
        "time_unit": {"const": "s"},
        "quaternion_order": {"const": "wxyz"},
        "rotation": {"const": "active_body_to_world"}
      }
    },
    "capabilities": {"type": "object"},
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}}
  },
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "matrix3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vector3"}},
    "sample": {"type": "object", "required": ["time_s", "translation", "rotation_wxyz"], "properties": {"time_s": {"type": "number"}, "translation": {"$ref": "#/$defs/vector3"}, "rotation_wxyz": {"$ref": "#/$defs/quaternion"}}},
    "geometryReference": {"type": "object", "required": ["uri"], "properties": {"uri": {"type": "string", "minLength": 1}, "object": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}, "additionalProperties": false},
    "track": {"type": "object", "required": ["id", "index", "name", "samples"], "properties": {"id": {"type": "string", "minLength": 1}, "index": {"type": "integer", "minimum": 0}, "name": {"type": "string", "minLength": 1}, "geometry_reference": {"$ref": "#/$defs/geometryReference"}, "samples": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sample"}}}}
  }
}
